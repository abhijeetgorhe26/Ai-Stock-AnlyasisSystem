# ─── System Architecture Environment Template ──────────────────────────

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server & Network Ports
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_stock_db?sslmode=disable

# Authentication & JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email Service (SMTP / Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ─── Stock Market Data APIs ───────────────────────────────────────────
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# ─── Indian Broker APIs ───────────────────────────────────────────────
ANGELONE_API_KEY=your_angelone_api_key_here
ANGELONE_CLIENT_CODE=your_angelone_client_code_here
ANGELONE_PASSWORD=your_angelone_password_here

UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:5001/api/auth/upstox/callback

DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ─── Financial News & Sentiment APIs ─────────────────────────────────
NEWS_API_KEY=your_news_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# ─── AI & LLM Inference APIs ─────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ─── Macroeconomic & Regulatory Data APIs ────────────────────────────
FRED_API_KEY=your_fred_api_key_here
SEC_EDGAR_USER_AGENT=YourName_or_Company_ContactEmail@example.com
